# ─────────────────────────────────────────────────────────────────────────────
# Masjid Al Ikhlas CGV Digital Ecosystem — Environment Variables
#
# Copy this file to .env and fill in real values.
# .env is excluded from version control via .gitignore — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Non-secret frontend data-source selector: local, proxy, or supabase.
# Normal `npm run dev` defaults to local; Netlify dev uses proxy mode.
VITE_DATA_SOURCE=local

# Public Supabase browser identifiers. These are not service-role secrets.
# Leave empty until the separate Masjid Al Ikhlas Supabase project is created.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Netlify Function configuration. Never prefix these with VITE_.
# Store real production values in platform secret management, not this file.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_VERSION=1
ADMIN_USER_ID=trial_admin
ADMIN_ALLOWED_ORIGINS=
INTEGRATION_ENV=local
ADMIN_LOGIN_RATE_LIMIT_MAX_FAILURES=5
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Future write kill switch. Absent or any value other than exact "true" is false.
# No mutation endpoint exists in the current phase.
PROGRAM_TRIAL_WRITES_ENABLED=false
