# ─────────────────────────────────────────────────────────────────────────────
# Masjid Al Ikhlas CGV Digital Ecosystem — Environment Variables
#
# Copy this file to .env and fill in real values.
# .env is excluded from version control via .gitignore — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Google Apps Script deployment URL (production Web App endpoint).
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# Leave empty to disable live API calls (fallback data will be used instead).
VITE_GAS_URL=

# Temporary admin PIN for prototype route protection.
# Used by src/services/auth.js to guard /app and /tpq routes.
# ⚠️  This is prototype security only — replace with real auth before launch.
# Leave empty to disable the PIN gate entirely (open access in local dev).
VITE_ADMIN_PIN=
